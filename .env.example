POSTGRES_USERNAME=postgres
POSTGRES_DB=leetcode_buddy
POSTGRES_PASSWORD=example
POSTGRES_URL=localhost:5432

# "development" enables CORS for the Vite dev server. Anything else disables it, because in
# production the SPA and API are served from a single origin behind Traefik.
APP_ENV=development

# This app is single-user. The authenticating reverse proxy (Authelia via Traefik
# ForwardAuth) reports OWNER_USERNAME in the Remote-User header, and every row in the
# database is written under OWNER_USER_ID. In local development the Vite dev proxy sets the
# header — see frontend/vite.config.ts, and keep the two usernames in sync.
OWNER_USERNAME=dev-owner
OWNER_USER_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:example@localhost:5432/leetcode_buddy
